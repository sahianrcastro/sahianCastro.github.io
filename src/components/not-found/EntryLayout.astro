---
import BaseLayout from "@components/base/BaseLayout.astro";
import Button from "@components/common/Button.astro";
---

<BaseLayout title="Página no encontrada">
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="glass rounded-lg p-4 sm:col-10 md:col-8 lg:col-6 intersect:animate-fadeUp opacity-0">
          <p class="text-[8rem] leading-none font-bold block">404</p>
          <h1 class="h2 mb-4">Página no encontrada</h1>
          <p class="mb-8">
            La página que buscas no existe o cambió de dirección.
          </p>
          <Button link="/" label="Volver al inicio" hoverInvert />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
