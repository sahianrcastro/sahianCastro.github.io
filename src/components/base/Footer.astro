---
import Social from "@components/common/Social.astro";
import CopyToast from "@components/common/CopyToast.astro";
import { withBase } from "@lib/url";
import { FaEnvelope } from "react-icons/fa";

const year = new Date().getFullYear();
const email = "sahianrcastro@gmail.com";
---

<footer class="glass container lg:my-4 lg:rounded-lg intersect:animate-fadeUp opacity-0">
  <div class="row py-2 lg:py-0 items-center flex-wrap-reverse">
    <div class="text-center lg:col-6 lg:mb-0 lg:text-left">
      <ul>
        <li class="m-2 inline-block">
          <a href={withBase("/presentacion")}>&copy; {year} Sahian Johana Rincón Castro (Sayis)</a>
        </li>
      </ul>
    </div>
    <div class="text-center lg:col-6 lg:my-0 flex flex-wrap items-center justify-center gap-1 lg:justify-end">
      <a
        href={`mailto:${email}`}
        data-copy-text={email}
        data-copy-message={`¡Correo copiado: ${email}!`}
        class="glass-t inline-flex h-9 items-center gap-2 rounded px-3 text-sm font-semibold text-txt-p no-underline dark:text-darkmode-txt-p"
        aria-label={`Copiar correo ${email}`}
        title="Clic para copiar el correo"
      >
        <FaEnvelope className="h-4 w-4" />
        <span>{email}</span>
      </a>
      <Social
        links={{
          github: "https://github.com/sahianrcastro",
        }}
      />
    </div>
  </div>
</footer>
<CopyToast />
