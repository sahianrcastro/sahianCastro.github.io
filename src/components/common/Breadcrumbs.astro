---
import { lowerHumanize } from "@lib/textConverter";
import { withBase, stripBase } from "@lib/url";

const { className }: { className?: string } = Astro.props;

const labels: Record<string, string> = {
  presentacion: "Presentación",
  evidencias: "Evidencias",
  modelado: "Modelado",
  normalizacion: "Normalización",
  sql: "SQL",
  proyecto: "Proyecto",
};

const current = stripBase(Astro.url.pathname);
const paths = current.split("/").filter((x) => x);
let parts = [
  {
    label: "Inicio",
    href: withBase("/"),
    "aria-label": current === "/" ? "page" : undefined,
  },
];

paths.forEach((label: string, i: number) => {
  const path = `/${paths.slice(0, i + 1).join("/")}`;
  label !== "page" &&
    parts.push({
      label: labels[label] ?? (lowerHumanize(label.replace(/[-_]/g, " ")) || ""),
      href: withBase(path),
      "aria-label": current === path ? "page" : undefined,
    });
});
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="inline-flex flex-wrap justify-center" role="list">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="mx-1" role="listitem">
          {index > 0 && <span class="inline-block mr-1">/</span>}
          {index !== parts.length - 1 ? (
            <a class="text-txt-p dark:text-darkmode-txt-p" {...attrs}>
              {label}
            </a>
          ) : (
            <span class="text-txt-light dark:text-darkmode-txt-light">{label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
