---
import BaseLayout from "@components/base/BaseLayout.astro";
import PageHeader from "@components/common/PageHeader.astro";
import { Image } from "astro:assets";
import type { AboutEntry } from "@/types";
import { render } from "astro:content";
import { toEmbedUrl, toSpotifyEmbed } from "@lib/url";
import { FaVideo, FaTools, FaDatabase, FaCode, FaGlobe, FaLaptopCode } from "react-icons/fa";

interface Props {
  entry: AboutEntry;
}

const { entry } = Astro.props;
const { title, description, image, imageAlt, fullName, nickname, videoUrl, spotifyUrl, tools } = entry.data;
const { Content } = await render(entry);
const embedUrl = videoUrl.trim() ? toEmbedUrl(videoUrl.trim()) : "";
const categoryIcons: Record<string, any> = {
  "Bases de Datos": FaDatabase,
  "Lenguajes": FaCode,
  "Desarrollo Web y APIs": FaGlobe,
  "Entornos y Herramientas": FaLaptopCode,
};
const spotifyEmbed = spotifyUrl.trim() ? toSpotifyEmbed(spotifyUrl.trim()) : "";
---

<BaseLayout title={title} description={description} image={image?.src}>
  <PageHeader title={title} />

  <section class="section-sm pt-4">
    <div class="container">
      <div class="row justify-center">
        <div class="glass rounded-lg p-6 md:p-8 col-12 lg:col-10 intersect:animate-fadeUp opacity-0 intersect-no-queue">
          <div class="flex flex-col items-center gap-6 md:flex-row md:items-center md:gap-10">
            {
              image && (
                <Image
                  class="mx-0 h-44 w-44 shrink-0 rounded-full object-cover object-center border-4 border-white dark:border-darkmode-bg-s shadow-lg md:h-56 md:w-56"
                  src={image}
                  alt={imageAlt}
                  width={512}
                  height={512}
                  loading="eager"
                />
              )
            }
            <div class="text-center md:text-left">
              {nickname && <h2 class="h3 mb-1">¡Hola, soy {nickname}!</h2>}
              {fullName && (
                <p class="mb-4 text-txt-light dark:text-darkmode-txt-light">{fullName}</p>
              )}
              <div class="content">
                <Content />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row justify-center mt-8">
        <div class="glass rounded-lg p-6 md:p-8 col-12 lg:col-10 intersect:animate-fadeUp opacity-0 intersect-no-queue">
          <h2 class="h4 mb-4 flex items-center gap-2">
            <FaVideo className="inline-block" /> Video de presentación
          </h2>

          <div class="relative w-full overflow-hidden rounded-lg aspect-video bg-bg-s dark:bg-darkmode-bg-s">
            <!-- REEMPLAZAR CON LINK DEL VIDEO -->
            <!-- El enlace se pega en src/content/about/-index.md, en el campo "videoUrl". -->
            <!-- Ejemplo: videoUrl: "https://www.youtube.com/watch?v=XXXXXXXXXXX" -->
            {
              embedUrl ? (
                <iframe
                  class="absolute inset-0 h-full w-full"
                  src={embedUrl}
                  title={`Video de presentación de ${nickname ?? "Sayis"}`}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                />
              ) : (
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 border-2 border-dashed border-border dark:border-darkmode-border rounded-lg p-4 text-center">
                  <FaVideo className="h-10 w-10 opacity-60" />
                  <span class="font-semibold text-txt-p dark:text-darkmode-txt-p">Video próximamente</span>
                  <span class="text-sm text-txt-light dark:text-darkmode-txt-light">
                    Aquí aparecerá mi video de presentación.
                  </span>
                </div>
              )
            }
          </div>
        </div>
      </div>

      <div class="row justify-center mt-8">
        <div class="glass rounded-lg p-6 md:p-8 col-12 lg:col-10 intersect:animate-fadeUp opacity-0 intersect-no-queue">
          {
            tools.length > 0 && (
              <div>
                <h2 class="h4 mb-4 flex items-center gap-2">
                  <FaTools className="inline-block" /> Herramientas y tecnologías
                </h2>
                <div class="grid gap-4 md:grid-cols-2">
                  {tools.map((group) => {
                    const Icon = categoryIcons[group.category] ?? FaTools;
                    return (
                      <div class="rounded-lg border border-border dark:border-darkmode-border p-4">
                        <h3 class="h6 mb-3 flex items-center gap-2 font-semibold">
                          <Icon className="inline-block opacity-70" /> {group.category}
                        </h3>
                        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
                          {group.items.map((tool) => (
                            <li class="glass-t shadow-none rounded-full px-3 py-0.5 text-sm font-medium text-txt-p dark:text-darkmode-txt-p">
                              {tool}
                            </li>
                          ))}
                        </ul>
                      </div>
                    );
                  })}
                </div>
              </div>
            )
          }

        </div>
      </div>

      {
        spotifyEmbed && (
          <div class="row justify-center mt-8">
            <div class="glass rounded-lg p-6 md:p-8 col-12 lg:col-10 intersect:animate-fadeUp opacity-0 intersect-no-queue">
              <h2 class="h5 mb-4 text-txt-light dark:text-darkmode-txt-light">
                🎧 Mi soundtrack para programar y modelar bases de datos
              </h2>
              <iframe
                class="block w-full rounded-xl border-0"
                src={spotifyEmbed}
                title="Playlist de Spotify de Sayis"
                height="152"
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              />
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
