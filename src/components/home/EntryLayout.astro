---
import BaseLayout from "@components/base/BaseLayout.astro";
import { markdownify } from "@lib/textConverter";
import Button from "@components/common/Button.astro";
import type { HomeEntry } from "@/types";
import { Image } from "astro:assets";
import { withBase } from "@lib/url";

interface Props {
  entry: HomeEntry;
}

const { entry } = Astro.props;
const { image, imageAlt, title, content, buttons } = entry.data;

const greetingGif = withBase("/images/cinnamoroll-saludo.gif");
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="text-center px-4 sm:col-10 md:col-8 lg:col-6">
          {
            image && (
              <Image
                class="mx-auto mb-6 h-40 w-40 sm:h-52 sm:w-52 rounded-full object-cover object-center border-4 border-white dark:border-darkmode-bg-s shadow-lg"
                src={image}
                alt={imageAlt}
                width={512}
                height={512}
                loading="eager"
              />
            )
          }
          <div class="mb-4 flex items-center justify-center gap-3">
            <span class="w-[50px] shrink-0" aria-hidden="true"></span>
            <h1 set:html={markdownify(title)} class="mb-0" />
            <img
              src={greetingGif}
              alt="Cinnamoroll saludando"
              width="50"
              height="50"
              class="mx-0 h-[50px] w-[50px] shrink-0 object-contain"
              loading="eager"
              onerror="this.style.visibility='hidden'"
            />
          </div>
          <p set:html={markdownify(content)} class="mb-8" />
          <div class="flex flex-wrap justify-center gap-3">
            {
              buttons.map((button) => (
                <Button
                  label={button.label}
                  link={button.link}
                  newtab={/^https?:/.test(button.link)}
                  hoverInvert
                  color=""
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
