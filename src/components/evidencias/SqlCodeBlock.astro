---
import { Code } from "astro:components";
import { FaRegCopy } from "react-icons/fa";

interface Props {
  id: string;
  code: string;
  title?: string;
  badge?: string;
  description?: string;
  maxHeight?: boolean;
}

const { id, code, title, badge, description, maxHeight = true } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-border dark:border-darkmode-border">
  {
    (title || badge) && (
      <div class="flex flex-wrap items-center gap-2 border-b border-border bg-bg-s/40 px-4 py-2 dark:border-darkmode-border dark:bg-darkmode-bg-s/40">
        {title && <span class="text-sm font-semibold text-txt-p dark:text-darkmode-txt-p">{title}</span>}
        {badge && (
          <span class="rounded-full bg-sky-200/70 px-2 py-0.5 text-[0.7rem] font-semibold text-sky-950 dark:bg-sky-400/25 dark:text-sky-100">
            {badge}
          </span>
        )}
      </div>
    )
  }
  {description && (
    <div class="border-b border-border px-4 py-2 text-xs text-txt-light dark:border-darkmode-border dark:text-darkmode-txt-light">
      {description}
    </div>
  )}
  <div class="relative">
    <button
      type="button"
      data-copy-from={id}
      data-copy-message="Código copiado al portapapeles"
      class="absolute right-2 top-2 z-10 inline-flex items-center gap-1.5 rounded-md border border-border bg-bg-p/90 px-2.5 py-1 text-xs font-semibold text-txt-p shadow-sm transition hover:bg-bg-s dark:border-darkmode-border dark:bg-darkmode-bg-p/90 dark:text-darkmode-txt-p dark:hover:bg-darkmode-bg-s"
      aria-label={`Copiar código${title ? `: ${title}` : ""}`}
    >
      <FaRegCopy className="h-3.5 w-3.5" /> <span data-copy-label>Copiar código</span>
    </button>
    <div id={id} class={`sql-code text-[0.8rem] leading-relaxed ${maxHeight ? "max-h-[30rem]" : ""} overflow-auto`}>
      <Code code={code} lang="sql" themes={{ light: "light-plus", dark: "dark-plus" }} />
    </div>
  </div>
</div>
